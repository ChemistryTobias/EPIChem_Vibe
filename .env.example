# Copy to `.env` to override any of the defaults baked into compose.yaml.
#
# You do NOT need this file to run the dev stack — `docker compose up` works on
# a clean clone with none of these set. It exists for the cases where the
# defaults collide with something already running on your machine, or where you
# want to exercise the auth path locally.
#
# `.env` is gitignored. Never commit real tokens or passwords.

# ---------------------------------------------------------------- database
POSTGRES_USER=epichem
POSTGRES_PASSWORD=epichem
POSTGRES_DB=epichem

# Where the API stores data. Unset, it falls back to a throwaway SQLite file, which
# is wiped on every restart — including the users and auth tokens, so you get
# signed out of the console each time you restart the backend.
#
# To keep a dev session across restarts, run Postgres and point the API at it:
#
#   docker compose up -d db
#   cd backend && DATABASE_URL=postgresql+psycopg://epichem:epichem@127.0.0.1:5432/epichem \
#     .venv/bin/uvicorn app.main:app --port 8000
#
# `docker compose up` sets this for the api service itself; the line above is
# for running the backend directly on the host.
# DATABASE_URL=postgresql+psycopg://epichem:epichem@127.0.0.1:5432/epichem

# ------------------------------------------------------------------- ports
# Change these if 5432/8000/5173/60610 are already taken on your machine.
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=5173
STATION_SIM_PORT=60610

# ------------------------------------------------------------ station pods
# The API key EPIChem sends to every station's bluesky-httpserver, and the key
# the bundled station-sim pod accepts. Letters and digits only -- the HTTP
# server rejects anything else at startup. See docs/BLUESKY.md.
EPICHEM_QSERVER_API_KEY=epichemdevkey
# How much faster than real time the simulated instruments run.
EPICHEM_SIM_SPEED=10

# -------------------------------------------------------------------- CORS
# Not needed for the dev stack: Vite proxies /api, so the browser only ever
# talks to one origin. Only relevant if you serve the console from somewhere
# other than the API's origin.
# EPICHEM_CORS_ORIGINS=https://epichem.example.org

# ----------------------------------------------------------------- watching
# Polling file-watch for the Vite dev server. Needed on macOS and Windows,
# where bind mounts don't deliver inotify events reliably. Set to false on
# Linux to save a little CPU.
CHOKIDAR_USEPOLLING=true
