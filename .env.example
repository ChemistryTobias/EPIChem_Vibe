# Copy to `.env` to override any of the defaults baked into compose.yaml.
#
# You do NOT need this file to run the dev stack — `docker compose up` works on
# a clean clone with none of these set. It exists for the cases where the
# defaults collide with something already running on your machine, or where you
# want to exercise the auth path locally.
#
# `.env` is gitignored. Never commit real tokens or passwords.

# ---------------------------------------------------------------- database
POSTGRES_USER=epichem
POSTGRES_PASSWORD=epichem
POSTGRES_DB=epichem

# ------------------------------------------------------------------- ports
# Change these if 5432/8000/5173 are already taken on your machine.
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=5173

# -------------------------------------------------------------------- auth
# Comma-separated `label:token` pairs. Writes (POST/PUT/DELETE) then require
# `Authorization: Bearer <token>`, and the label is recorded as the revision's
# created_by (ADR 0004). Reads are always open.
#
# LEAVE THIS EMPTY for local development — that is the deliberate default, and
# the API prints a startup warning so it stays a choice rather than an
# oversight. Set it to try the auth path; paste the token into the console's
# sidebar field to make writes work again.
#
# EPICHEM_API_TOKENS=dev:local-dev-token-not-a-secret

# -------------------------------------------------------------------- CORS
# Not needed for the dev stack: Vite proxies /api, so the browser only ever
# talks to one origin. Only relevant if you serve the console from somewhere
# other than the API's origin.
# EPICHEM_CORS_ORIGINS=https://epichem.example.org

# ----------------------------------------------------------------- watching
# Polling file-watch for the Vite dev server. Needed on macOS and Windows,
# where bind mounts don't deliver inotify events reliably. Set to false on
# Linux to save a little CPU.
CHOKIDAR_USEPOLLING=true
